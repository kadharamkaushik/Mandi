{
  "name": "mandi",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "contracts:lint": "pnpm --filter @mandi/contracts lint",
    "contracts:gen": "pnpm --filter @mandi/contracts generate"
  }
}
